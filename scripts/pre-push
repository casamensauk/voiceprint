#!/usr/bin/env bash
# Block direct pushes to main; all changes go through pull requests.
set -euo pipefail
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are blocked. Open a pull request instead." >&2
    exit 1
  fi
done
exit 0
